{
  "name": "postfix-bridge",
  "version": "1.0.0",
  "description": "Provides a bridge between Postfix and the RapidMX server.",
  "type": "module",
  "repository": "https://github.com/rapidmx/postfix-bridge",
  "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
  "license": "MPL-2.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "debug": "tsx watch --inspect src/index.ts",
    "lint": "eslint ./src ./test",
    "start": "node dist/src/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch --coverage",
    "release": "npx @rapidrest/cli release",
    "prepublish": "yarn build"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "dependencies": {
    "smtp-server": "^3.13.6"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.8",
    "globals": "^17.12.0",
    "nodemailer": "^10.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.2.2",
  "engines": {
    "node": ">=24.0.0"
  }
}
